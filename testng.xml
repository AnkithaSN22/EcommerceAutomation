<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="SauceDemo E-Commerce Test Automation Suite" verbose="2" parallel="false">

    <listeners>
        <listener class-name="utilities.TestListener" />
    </listeners>

    <test name="E-Commerce Functional &amp; Regression Tests">
        <parameter name="browser" value="chrome" />
        <classes>
            <class name="tests.LoginTest" />
            <class name="tests.ProductTest" />
            <class name="tests.CartTest" />
            <class name="tests.CheckoutTest" />
            <class name="tests.EndToEndTest" />
        </classes>
    </test>

</suite>
